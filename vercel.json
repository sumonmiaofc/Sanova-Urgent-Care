{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/blog/:slug*", "destination": "/blog-post.html?slug=:slug*" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/contact", "destination": "/contact.html" },
    { "source": "/services", "destination": "/services.html" },
    { "source": "/gallery", "destination": "/gallery.html" },
    { "source": "/meet-the-team", "destination": "/meet-the-team.html" },
    { "source": "/patient-info", "destination": "/patient-info.html" },
    { "source": "/iv-hydration", "destination": "/iv-hydration.html" },
    { "source": "/admin", "destination": "/admin/login.html" },
    { "source": "/admin/dashboard", "destination": "/admin/dashboard.html" },
    { "source": "/admin/blogs", "destination": "/admin/blogs.html" },
    { "source": "/admin/create-blog", "destination": "/admin/create-blog.html" },
    { "source": "/admin/categories", "destination": "/admin/categories.html" },
    { "source": "/admin/analytics", "destination": "/admin/analytics.html" },
    { "source": "/admin/settings", "destination": "/admin/settings.html" }
  ]
}